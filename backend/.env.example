# =====================================================================
# ProofLens Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual keys.
# NEVER commit .env to version control.
# =====================================================================

# Database Configuration (PostgreSQL / Supabase / Render or local SQLite fallback)
# If omitted or unreachable, ProofLens automatically falls back to local SQLite (sqlite:///./sql_app.db)
DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host:5432/prooflens_db

# Server Configuration
PORT=8000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:4200

# PayPal REST & Identity API Configuration (Sandbox)
# Obtain your Client ID and Secret from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_REDIRECT_URI=http://localhost:4200

# Google Gemini API Key (Multimodal Vision & Contract Legal Addendum Drafting)
# Obtain key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here
