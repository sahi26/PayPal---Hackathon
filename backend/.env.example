# Copy to backend/.env for local development. Never commit real credentials.
APP_ENV=development
PORT=8000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:4200

# Local development uses SQLite when DATABASE_URL is unset.
# Production requires an explicitly configured, reachable PostgreSQL DATABASE_URL.
DATABASE_URL=
USE_LOCAL_DB=false

# Development generates an ephemeral JWT secret if this is unset.
# Production requires a persistent, randomly generated secret of at least 32 characters.
JWT_SECRET_KEY=
ACCESS_TOKEN_MINUTES=60

# PayPal sandbox credentials. Use the live API base and live credentials in production.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id
PAYPAL_REDIRECT_URI=https://pay-pal-hackathon-phi.vercel.app

# Required in production for protected administrative endpoints.
ADMIN_API_TOKEN=

# Optional AI analysis
GEMINI_API_KEY=

# Use a persistent volume path for production evidence files.
# UPLOADS_DIR=/path/to/persistent/uploads
